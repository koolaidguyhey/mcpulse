# Supabase project URL, e.g. https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...). SERVER ONLY; NEVER put this in frontend code.
SUPABASE_SECRET_KEY=
# Older projects can use the legacy service_role key instead (deprecated by Supabase).
# SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to HMAC API keys before storing them. Generate 32+ random bytes.
API_KEY_PEPPER=
# Comma-separated exact frontend origins. Example: https://YOURNAME.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=3000
# Defaults; keep conservative on free hosting.
REQUEST_TIMEOUT_MS=5000
RATE_LIMIT_PER_MINUTE=60
